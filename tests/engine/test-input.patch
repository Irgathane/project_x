diff --git a/Quake/test_input.c b/Quake/test_input.c
new file mode 100644
index 0000000..eee31a4
--- /dev/null
+++ b/Quake/test_input.c
@@ -0,0 +1,225 @@
+/*
+test_input.c -- scripted input + state tracing for automated tests
+
+Not part of upstream QuakeSpasm. See tests/README.md.
+
+Input is injected in CL_BaseMove(), which is the single place the client turns
+keyboard state into a usercmd, and state is traced from CL_SendCmd(). Combined
+with "host_framerate" (fixed timestep) this makes a listen-server session
+reproducible enough to assert on: positions, velocities, viewangles, ammo,
+health. The server is never modified, so what the tests exercise is the real
+movement/physics/QuakeC path.
+*/
+
+#include "quakedef.h"
+#include "test_input.h"
+
+cvar_t	test_input = {"test_input", "", CVAR_NONE};
+cvar_t	test_trace = {"test_trace", "", CVAR_NONE};
+cvar_t	test_quit_eof = {"test_quit_eof", "0", CVAR_NONE};
+
+static FILE	*script_file;
+static FILE	*trace_file;
+static int	 script_line;
+static int	 trace_frame;
+static int	 scripted_buttons;
+static int	 scripted_impulse;
+static qboolean	 script_done;
+
+#ifndef SERVERONLY
+extern	server_t	sv;
+extern	edict_t		*sv_player;
+#endif
+
+
+void TestInput_Init (void)
+{
+	int	p;
+
+	Cvar_RegisterVariable (&test_input);
+	Cvar_RegisterVariable (&test_trace);
+	Cvar_RegisterVariable (&test_quit_eof);
+
+	/* QuakeSpasm 0.85 has no "set" command, so the harness is driven by
+	   dedicated command-line parameters instead of +set. */
+	p = COM_CheckParm ("-test_input");
+	if (p && p + 1 < com_argc)
+		Cvar_Set ("test_input", com_argv[p + 1]);
+
+	p = COM_CheckParm ("-test_trace");
+	if (p && p + 1 < com_argc)
+		Cvar_Set ("test_trace", com_argv[p + 1]);
+
+	if (COM_CheckParm ("-test_quit_eof"))
+		Cvar_SetValue ("test_quit_eof", 1);
+
+	/* fixed timestep: one script line is one frame */
+	p = COM_CheckParm ("-test_fps");
+	if (p && p + 1 < com_argc)
+	{
+		float fps = Q_atof (com_argv[p + 1]);
+
+		if (fps > 0)
+			Cvar_SetValue ("host_framerate", 1.0 / fps);
+	}
+}
+
+
+qboolean TestInput_Active (void)
+{
+	return test_input.string[0] != '\0' && !script_done;
+}
+
+
+int TestInput_Buttons (void)
+{
+	return scripted_buttons;
+}
+
+
+int TestInput_Impulse (void)
+{
+	return scripted_impulse;
+}
+
+
+static FILE *TestInput_ScriptFile (void)
+{
+	if (!script_file)
+	{
+		script_file = fopen (test_input.string, "r");
+		if (!script_file)
+		{
+			Con_Printf ("TEST: cannot open input script \"%s\"\n", test_input.string);
+			Cvar_Set ("test_input", "");
+		}
+	}
+
+	return script_file;
+}
+
+
+/*
+====================
+TestInput_OverrideMove
+
+Replaces the keyboard-derived usercmd with the next scripted line.
+====================
+*/
+void TestInput_OverrideMove (usercmd_t *cmd)
+{
+	char	line[256];
+	float	yaw, pitch, roll, forwardmove, sidemove, upmove;
+	int	buttons, impulse, parsed;
+	FILE	*f;
+
+	if (!TestInput_Active ())
+		return;
+
+	f = TestInput_ScriptFile ();
+	if (!f)
+		return;
+
+	while (fgets (line, sizeof(line), f))
+	{
+		script_line++;
+
+		if (line[0] == '#' || line[0] == '\n' || line[0] == '\r' || line[0] == '\0')
+			continue;
+
+		buttons = 0;
+		impulse = 0;
+		parsed = sscanf (line, "%f %f %f %f %f %f %d %d",
+			&yaw, &pitch, &roll, &forwardmove, &sidemove, &upmove, &buttons, &impulse);
+
+		if (parsed < 6)
+		{
+			Con_Printf ("TEST: %s:%d: expected at least 6 numbers, got %d\n",
+				test_input.string, script_line, parsed);
+			continue;
+		}
+
+		cl.viewangles[PITCH] = pitch;
+		cl.viewangles[YAW] = yaw;
+		cl.viewangles[ROLL] = roll;
+
+		cmd->forwardmove = forwardmove;
+		cmd->sidemove = sidemove;
+		cmd->upmove = upmove;
+
+		/* usercmd_t carries movement only; buttons and impulse live in
+		   cl_input.c and are picked up from here by the caller */
+		scripted_buttons = buttons;
+		scripted_impulse = impulse;
+		return;
+	}
+
+	/* end of script */
+	Con_Printf ("TEST: input script \"%s\" finished after %d frames\n",
+		test_input.string, script_line);
+	script_done = true;
+	fclose (script_file);
+	script_file = NULL;
+
+	if (test_quit_eof.value)
+		Cbuf_AddText ("quit\n");
+}
+
+
+/*
+====================
+TestInput_TraceFrame
+
+Appends one CSV row of the local player's state. Silent when test_trace is unset.
+====================
+*/
+void TestInput_TraceFrame (void)
+{
+#ifndef SERVERONLY
+	edict_t	*pl;
+
+	if (!test_trace.string[0])
+		return;
+
+	if (!trace_file)
+	{
+		trace_file = fopen (test_trace.string, "w");
+		if (!trace_file)
+		{
+			Con_Printf ("TEST: cannot write trace \"%s\"\n", test_trace.string);
+			Cvar_Set ("test_trace", "");
+			return;
+		}
+
+		fprintf (trace_file,
+			"frame,time,px,py,pz,vx,vy,vz,yaw,pitch,roll,"
+			"health,armor,shells,nails,rockets,cells,weapon,items,flags,onground,waterlevel\n");
+	}
+
+	if (!sv.active || !sv_player)
+		return;
+
+	pl = sv_player;
+
+	fprintf (trace_file,
+		"%d,%.4f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+		trace_frame++,
+		cl.time,
+		pl->v.origin[0], pl->v.origin[1], pl->v.origin[2],
+		pl->v.velocity[0], pl->v.velocity[1], pl->v.velocity[2],
+		cl.viewangles[YAW], cl.viewangles[PITCH], cl.viewangles[ROLL],
+		(int) pl->v.health,
+		(int) pl->v.armorvalue,
+		(int) pl->v.ammo_shells,
+		(int) pl->v.ammo_nails,
+		(int) pl->v.ammo_rockets,
+		(int) pl->v.ammo_cells,
+		(int) pl->v.weapon,
+		(int) pl->v.items,
+		(int) pl->v.flags,
+		((int) pl->v.flags & FL_ONGROUND) ? 1 : 0,
+		(int) pl->v.waterlevel);
+
+	fflush (trace_file);
+#endif
+}
\ No newline at end of file
diff --git a/Quake/test_input.h b/Quake/test_input.h
new file mode 100644
index 0000000..94ccbfa
--- /dev/null
+++ b/Quake/test_input.h
@@ -0,0 +1,26 @@
+/*
+test_input.h -- scripted input + state tracing for automated tests
+
+Not part of upstream QuakeSpasm. See tests/README.md.
+
+The script file is one command per client frame:
+    <yaw> <pitch> <roll> <forwardmove> <sidemove> <upmove> [buttons] [impulse]
+Blank lines and lines starting with '#' are skipped.
+
+The trace file is CSV, one row per client frame, written before that frame's
+command is simulated (so it lags the world by one frame).
+*/
+
+#ifndef TEST_INPUT_H
+#define TEST_INPUT_H
+
+/* quakedef.h must be included before this header (usercmd_t, qboolean) */
+
+void TestInput_Init (void);
+qboolean TestInput_Active (void);
+void TestInput_OverrideMove (usercmd_t *cmd);
+int TestInput_Buttons (void);
+int TestInput_Impulse (void);
+void TestInput_TraceFrame (void);
+
+#endif /* TEST_INPUT_H */
\ No newline at end of file
